{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Python Discovery",
  "version": "0.3.2",
  "identifier": "dev.pythondiscovery.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Python Discovery",
        "width": 1480,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Education",
    "shortDescription": "Local-first, gamified Python learning editor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["python3"],
        "recommends": ["bubblewrap"]
      }
    }
  }
}
