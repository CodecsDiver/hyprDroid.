class_name DamageInfo
extends RefCounted
## A single instance of damage travelling from a source to a target.

var amount: float = 0.0
var source_actor_id: int = -1
var source_team: int = TeamIds.NEUTRAL
var ability_id: StringName = &""
var is_crit: bool = false
## False for damage generated by item procs, which prevents proc chains.
var can_proc: bool = true
var ignores_armor: bool = false
var knockback_direction: Vector3 = Vector3.ZERO
var knockback_strength: float = 0.0
## Fraction of damage dealt that heals the source (ability-level lifesteal).
var lifesteal_fraction: float = 0.0
var slow_multiplier: float = 1.0
var slow_duration: float = 0.0


func duplicate_info() -> DamageInfo:
	var copy := DamageInfo.new()
	copy.amount = amount
	copy.source_actor_id = source_actor_id
	copy.source_team = source_team
	copy.ability_id = ability_id
	copy.is_crit = is_crit
	copy.can_proc = can_proc
	copy.ignores_armor = ignores_armor
	copy.knockback_direction = knockback_direction
	copy.knockback_strength = knockback_strength
	copy.lifesteal_fraction = lifesteal_fraction
	copy.slow_multiplier = slow_multiplier
	copy.slow_duration = slow_duration
	return copy
