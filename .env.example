# Copy to .env.local. These two values are PUBLIC by design (the anon key is
# protected by Row Level Security). NEVER put the service-role key in any
# VITE_* variable: Vite inlines those into the browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: expose the backend-free 3D scene preview (#/scene-preview) in a production build.
# VITE_ENABLE_SCENE_PREVIEW=1
