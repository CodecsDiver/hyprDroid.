{
  "name": "python-discovery",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pyodide.mjs && vite",
    "build": "vue-tsc --noEmit && vite build --mode tauri",
    "build:web": "node scripts/copy-pyodide.mjs && vue-tsc --noEmit && vite build --mode web --outDir dist-web --emptyOutDir && node scripts/stamp-sw.mjs dist-web/sw.js",
    "preview:web": "vite preview --outDir dist-web --port 4173 --host",
    "test": "vitest run",
    "tauri": "tauri",
    "build:web-deb": "pnpm build:web && bash scripts/build-web-deb.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "monaco-editor": "^0.52.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "pyodide": "^314.0.7",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
